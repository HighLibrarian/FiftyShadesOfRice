# ignore everything
*

# allow these folders
!hypr/
!waybar/
!kitty/
!rofi/
!waypaper/
!swaync/
!fish/
!starship/
!fonts/
!setup/
!hypridle/
!linux-audio-switcher/
!monique/
!OpenRGB/
!flameshot/
!iris/
!tomat/

# allow their contents (but NOT recursively unignore everything)
hypr/*
waybar/*
kitty/*
rofi/*
waypaper/*
swaync/*
fish/*
starship/*
fonts/*
setup/*
hypridle/*
linux-audio-switcher/*
monique/*
OpenRGB/*
flameshot/*
iris/*
tomat/*
# now unignore everything inside those folders
!hypr/**
!waybar/**
!kitty/**
!rofi/**
!waypaper/**
!swaync/**
!fish/**
!starship/**
!fonts/**
!setup/**
!hypridle/**
!linux-audio-switcher/**
!monique/**
!OpenRGB/**
!flameshot/**
!iris/**
!tomat/**

# re-ignore specific files
hypr/modules/monitors.lua
hypr/modules/monitors.conf
OpenRGB/logs
fonts/.uuid
fonts/*/.uuid

# allow these single files
!starship.toml
!.gitignore
!README.md
