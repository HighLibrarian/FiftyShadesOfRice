/*****----- Configuration -----*****/
configuration {
	modi:                       "combi,drun,window";
    show-icons:                 true;
    icon-theme:                 "Papirus";
    window-thumbnail:           false;
    display-combi:              "󰍉";
    display-drun:               "";
    display-window:             "";
	drun-display-format:        "{name}";
	window-format:              "{w} · {c} · {t}";
}

/*****----- Global Properties -----*****/
@import "~/.config/rofi/globals/global-properties.rasi"

/*****----- Main Window -----*****/
window {
    /* properties for window widget */
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       800px;
    x-offset:                    0px;
    y-offset:                    0px;

    /* properties for all widgets */
    enabled:                     true;
    border-radius:               10px;
    cursor:                      "default";
    background-color:            @menu-background;
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                     true;
    spacing:                     0px;
    background-color:            transparent;
    orientation:                 vertical;
    children:                    [ "inputbar", "listbox" ];
}

listbox {
    spacing:                     15px;
    padding:                     15px;
    background-color:            transparent;
    orientation:                 vertical;
    children:                    [ "message", "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                     true;
    spacing:                     10px;
    padding:                     100px 60px;
    background-color:            transparent;
    background-image:            url("~/.cache/rofi-bg.png", width);
    font:                        @font-name;
    text-color:                  @text-primary;
    orientation:                 horizontal;
    children:                    [ "textbox-prompt-colon", "entry", "dummy", "mode-switcher" ];

}
textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    str:                         "";
    padding:                     12px 15px;
    border-radius:               12px;
    background-color:            @control-surface;
    text-color:                  inherit;
}
entry {
    enabled:                     true;
    expand:                      false;
    width:                       150px;
    padding:                     12px 16px;
    border-radius:               12px;
    background-color:            @control-surface;
    text-color:                  inherit;
    font:                        @font-name;
    cursor:                      text;
    placeholder:                 "Search";
    placeholder-color:           inherit;
}
dummy {
    expand:                      true;
    background-color:            transparent;
}

/*****----- Mode Switcher -----*****/
mode-switcher{
    enabled:                     true;
    spacing:                     10px;
    background-color:            transparent;
    text-color:                  @text-primary;
}
button {
    width:                       40px;
    padding:                     12px;
    border-radius:               12px;
    background-color:            @control-surface;
    text-color:                  inherit;
    cursor:                      pointer;
}
button selected {
    background-color:            @selection-background;
    text-color:                  @text-primary;
}

/*****----- Listview -----*****/
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       5;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    
    spacing:                     10px;
    background-color:            transparent;
    text-color:                  @text-primary;
    font:                        @font-name;    
    cursor:                      "default";
}

/*****----- Elements -----*****/
element {
    enabled:                     true;
    spacing:                     10px;
    padding:                     6px;
    border-radius:               10px;
    background-color:            transparent;
    text-color:                  @text-primary;
    
    cursor:                      pointer;
}
element normal.normal {
    background-color:            inherit;
    text-color:                  inherit;
}
element normal.urgent {
    background-color:            @state-urgent;
    text-color:                  @text-primary;
}
element normal.active {
    background-color:            @state-active;
    text-color:                  @text-primary;
}
element selected.normal {
    background-color:            @selection-background;
    text-color:                  @text-primary;
}
element selected.urgent {
    background-color:            @state-urgent;
    text-color:                  @text-primary;
}
element selected.active {
    background-color:            @state-active;
    text-color:                  @text-primary;
}
element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        24px;
    cursor:                      inherit;
}
element-text {
    font:                        @font-name;
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

/*****----- Message -----*****/
message {
    background-color:            transparent;
}
textbox {
    padding:                     10px;
    border-radius:               10px;
    background-color:            @control-surface;
    text-color:                  @text-primary;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}
error-message {
    padding:                     10px;
    border-radius:               10px;
    background-color:            @menu-background;
    text-color:                  @text-primary;
}
