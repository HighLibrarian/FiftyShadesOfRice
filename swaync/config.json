{
    "$schema": "/etc/xdg/swaync/configschema.json",
    "positionX": "center",
    "positionY": "top",
    "cssPriority": "user",

    "control-center-width": 450,
    "control-center-height": 600,

    "fit-to-screen": false,

    "notification-window-width": 400,
    "notification-icon-size": 40,
    "notification-body-image-height": 500,
    "notification-body-image-width": 500,
    "notification-inline-replies": true,
    "notification-2fa-action": false,
  
    "timeout": 3,
    "timeout-low": 2,
    "timeout-critical": 6,
    
    "keyboard-shortcuts": true,
    "image-visibility": "when-available",
    "transition-time": 200,
    "hide-on-clear": false,
    "hide-on-action": false,
    "script-fail-notify": true,

    "widgets": [
      "mpris",
      "dnd",
      "notifications",
      "buttons-grid"
    ],
   
    "widget-config": {
        "backlight": {
            "device": "amdgpu_bl1",
            "label": "󰃠",
            "slider": true,
            "min": 10
        },
        "volume": {
            "device": "default",
            "label": "",
            "slider": true
        },

        "dnd": {
            "text": "Do not disturb"
        },

        "mpris": {
            "image-size": 100,
            "image-radius": 10,
            "autohide": false,
            "blacklist": [ "org.mpris.MediaPlayer2.playerctld"]
        },

        "buttons-grid": {
            "actions": [
                {
                    "label": "󰌪",
                    "type": "toggle",
                    "command": "sh -c '[ \"$SWAYNC_TOGGLE_STATE\" = \"true\" ] && /usr/bin/powerprofilesctl set power-saver || /usr/bin/powerprofilesctl set balanced'",
                    "update-command": "sh -c 'profile=$(/usr/bin/powerprofilesctl get 2>/dev/null | tr -d \"[:space:]\"); [ \"$profile\" = \"power-saver\" ] && echo true || echo false'"
                    
                },
                {
                    "label": "󰴱",
                    "command": "bash -c 'hyprpicker -a -f hex -n'"
                },
                {
                    "label": "",
                    "type": "toggle",
                    "command": "bash -c '$HOME/.local/bin/mictoggle --silent'",
                    "update-command": "bash -c '$HOME/.local/bin/mictoggle --is-muted'"
                },
                {
                    "label": "",
                    "command": "hyprctl dispatch exec alacritty -- -e htop ; swaync-client -cp"
                },
                {
                    "label": "󰃟",
                    "type": "toggle",
                    "command": "bash -c '$HOME/.local/bin/themesw'",
                    "update-command": "bash -c '[ $($HOME/.local/bin/themesw --current) = light ] && echo true || echo false'"
                },
                {
                    "label": "",
                    "command": "hyprctl dispatch exec nwg-look ; swaync-client -cp"
                },
                {
                    "label": "",
                    "command": "swaync-client -cp ; bash -c $HOME/.config/rofi/bin/logout"
                }
            ]
        }
    }
  }
