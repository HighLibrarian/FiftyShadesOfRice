{
    "$schema": "/etc/xdg/swaync/configschema.json",
    "positionX": "center",
    "positionY": "top",
    "cssPriority": "user",

    "control-center-width": 450,
    "control-center-height": 700,

    "fit-to-screen": false,

    "notification-window-width": 400,
    "notification-icon-size": 40,
    "notification-body-image-height": 200,
    "notification-body-image-width": 500,
    "notification-inline-replies": true,
    "notification-2fa-action": false,
  
    "timeout": 5,
    "timeout-low": 2,
    "timeout-critical": 10,
    
    "keyboard-shortcuts": true,
    "image-visibility": "when-available",
    "transition-time": 200,
    "hide-on-clear": false,
    "hide-on-action": false,
    "script-fail-notify": true,

    "widgets": [
      "mpris",
      "dnd",
      "notifications",
      "buttons-grid"
    ],
   
    "widget-config": {

        "backlight": {
            "device": "amdgpu_bl1",
            "label": "󰃠",
            "slider": true,
            "min": 10
        },
        "volume": {
            "device": "default",
            "label": "",
            "slider": true
        },

        "dnd": {
            "text": "Do not disturb"
        },

        "mpris": {
            "image-size": 50,
            "image-radius": 10,
            "autohide": false,
            "blacklist": [ "org.mpris.MediaPlayer2.playerctld"]
        },

        "buttons-grid": {
            "actions": [
                {
                    "label": " 󰌪 ",
                    "type": "toggle",
                    "command": "sh $HOME/.config/swaync/scripts/toggle-performance-profile-command.sh",
                    "update-command": "sh $HOME/.config/swaync/scripts/toggle-performance-profile-update.sh"
                },                    
                {
                    "label": "󰴱",
                    "command": "bash -c 'hyprpicker -a -f hex -n'"
                },
                {
                    "label": "  ",
                    "type": "toggle",
                    "command": "sh $HOME/.config/swaync/scripts/toggle-mic-mute-command.sh",
                    "update-command": "sh $HOME/.config/swaync/scripts/toggle-mic-mute-update.sh"
                },
                {
                    "label": "  ",
                    "type": "toggle",
                    "command": "sh $HOME/.config/swaync/scripts/toggle-localsend-command.sh",
                    "update-command": "sh $HOME/.config/swaync/scripts/toggle-localsend-update.sh"
                    
                },
                {
                    "label": "  ",
                    "type": "toggle",
                    "command": "sh $HOME/.config/swaync/scripts/toggle-waypaper-command.sh",
                    "update-command": "sh $HOME/.config/swaync/scripts/toggle-waypaper-update.sh"
                },
                {
                    "label": "  ",
                    "type": "toggle",
                    "command": "sh $HOME/.config/swaync/scripts/toggle-steam-command.sh",
                    "update-command": "sh $HOME/.config/swaync/scripts/toggle-steam-update.sh"
                },
                {
                    "label": "  ",
                    "type": "toggle",
                    "command": "sh $HOME/.config/swaync/scripts/toggle-gamestreaming-command.sh",
                    "update-command": "sh $HOME/.config/swaync/scripts/toggle-gamestreaming-update.sh"
                }
            ]
        }
    }
  }
